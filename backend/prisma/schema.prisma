generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum StaffRole {
  OWNER
  MANAGER
  STAFF
}

enum StaffStatus {
  ACTIVE
  DISABLED
}

enum CommonStatus {
  ACTIVE
  DISABLED
}

enum InventoryMode {
  MANAGED
  UNMANAGED
}

enum RecipeMaterialRole {
  BASE
  TAKEAWAY_EXTRA
}

enum RecipeModifierTarget {
  BASE
  TAKEAWAY_EXTRA
}

enum OptionSelectionType {
  SINGLE
  MULTI
}

enum StockMovementType {
  OPENING_BALANCE
  STOCK_IN
  RESERVE
  RELEASE
  CONSUME
  ADJUST
}

enum OrderItemMaterialSource {
  BASE
  TAKEAWAY_EXTRA
  MODIFIER
}

enum OrderChannel {
  DINE
  TAKEAWAY
}

enum OrderStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  PREPARING
  COMPLETED
  CANCELLED
}

enum DiningSessionStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  WECHAT
  ALIPAY
  POS
  OTHER
}

enum PaymentStatus {
  ACTIVE
  VOIDED
}

enum RefundStatus {
  ACTIVE
  VOIDED
}

model Store {
  id                      BigInt          @id @default(autoincrement()) @map("id")
  name                    String          @map("name") @db.VarChar(120)
  status                  StoreStatus     @map("status")
  timezone                String          @default("Asia/Shanghai") @map("timezone") @db.VarChar(64)
  businessDayCutoffMinute Int             @default(0) @map("business_day_cutoff_minute")
  createdAt               DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  staff                   Staff[]
  categories              Category[]
  products                Product[]
  materials               Material[]
  tables                  DiningTable[]
  sessions                DiningSession[]
  orders                  Order[]
  stockMovements          StockMovement[]
  lossRecords             LossRecord[]
  payments                PaymentRecord[]

  @@map("stores")
}

model User {
  id        BigInt     @id @default(autoincrement()) @map("id")
  openid    String     @unique @map("openid") @db.VarChar(128)
  status    UserStatus @map("status")
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  orders    Order[]

  @@map("users")
}

model Staff {
  id             BigInt          @id @default(autoincrement()) @map("id")
  storeId        BigInt          @map("store_id")
  name           String          @map("name") @db.VarChar(80)
  role           StaffRole       @map("role")
  status         StaffStatus     @map("status")
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[] @relation("StockOperator")
  lossRecords    LossRecord[]    @relation("LossOperator")
  payments       PaymentRecord[] @relation("PaymentOperator")
  voidedPayments PaymentRecord[] @relation("PaymentVoidOperator")
  refunds        RefundRecord[]  @relation("RefundOperator")
  voidedRefunds  RefundRecord[]  @relation("RefundVoidOperator")
  closedSessions DiningSession[] @relation("SessionCloser")

  @@map("staff")
}

model Category {
  id        BigInt       @id @default(autoincrement()) @map("id")
  storeId   BigInt       @map("store_id")
  name      String       @map("name") @db.VarChar(80)
  sortOrder Int          @default(0) @map("sort_order")
  status    CommonStatus @map("status")
  createdAt DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  products  Product[]

  @@unique([storeId, name])
  @@map("categories")
}

model Product {
  id          BigInt           @id @default(autoincrement()) @map("id")
  storeId     BigInt           @map("store_id")
  categoryId  BigInt           @map("category_id")
  name        String           @map("name") @db.VarChar(120)
  description String?          @map("description") @db.Text
  imageUrl    String?          @map("image_url") @db.VarChar(512)
  status      CommonStatus     @map("status")
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  orderItems  OrderItem[]

  @@unique([storeId, name])
  @@index([categoryId, status, sortOrder])
  @@map("products")
}

model ProductVariant {
  id              BigInt               @id @default(autoincrement()) @map("id")
  productId       BigInt               @map("product_id")
  name            String               @map("name") @db.VarChar(80)
  priceFen        BigInt               @map("price_fen")
  inventoryMode   InventoryMode        @map("inventory_mode")
  status          CommonStatus         @map("status")
  sortOrder       Int                  @default(0) @map("sort_order")
  createdAt       DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  product         Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  optionGroups    VariantOptionGroup[]
  variantRecipes  VariantRecipe[]
  recipeModifiers RecipeModifier[]
  orderItems      OrderItem[]

  @@unique([productId, name])
  @@index([productId, status, sortOrder])
  @@map("product_variants")
}

model VariantOptionGroup {
  id            BigInt               @id @default(autoincrement()) @map("id")
  variantId     BigInt               @map("variant_id")
  name          String               @map("name") @db.VarChar(80)
  selectionType OptionSelectionType  @map("selection_type")
  required      Boolean              @map("required")
  sortOrder     Int                  @default(0) @map("sort_order")
  status        CommonStatus         @map("status")
  variant       ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  values        VariantOptionValue[]

  @@unique([variantId, name])
  @@map("variant_option_groups")
}

model VariantOptionValue {
  id               BigInt             @id @default(autoincrement()) @map("id")
  optionGroupId    BigInt             @map("option_group_id")
  name             String             @map("name") @db.VarChar(80)
  priceDeltaFen    BigInt             @default(0) @map("price_delta_fen")
  sortOrder        Int                @default(0) @map("sort_order")
  status           CommonStatus       @map("status")
  optionGroup      VariantOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Restrict)
  recipeModifiers  RecipeModifier[]
  orderItemOptions OrderItemOption[]

  @@unique([optionGroupId, name])
  @@map("variant_option_values")
}

model VariantRecipe {
  id         BigInt             @id @default(autoincrement()) @map("id")
  variantId  BigInt             @map("variant_id")
  materialId BigInt             @map("material_id")
  role       RecipeMaterialRole @map("role")
  quantity   Decimal            @map("quantity") @db.Decimal(18, 3)
  variant    ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  material   Material           @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([variantId, materialId, role])
  @@map("variant_recipes")
}

model RecipeModifier {
  id            BigInt               @id @default(autoincrement()) @map("id")
  variantId     BigInt               @map("variant_id")
  optionValueId BigInt               @map("option_value_id")
  materialId    BigInt               @map("material_id")
  targetRole    RecipeModifierTarget @map("target_role")
  quantityDelta Decimal              @map("quantity_delta") @db.Decimal(18, 3)
  variant       ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  optionValue   VariantOptionValue   @relation(fields: [optionValueId], references: [id], onDelete: Restrict)
  material      Material             @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([variantId, optionValueId, materialId, targetRole])
  @@index([optionValueId])
  @@map("recipe_modifiers")
}

model Material {
  id                 BigInt              @id @default(autoincrement()) @map("id")
  storeId            BigInt              @map("store_id")
  name               String              @map("name") @db.VarChar(120)
  unit               String              @map("unit") @db.VarChar(20)
  onHand             Decimal             @default(0) @map("on_hand") @db.Decimal(18, 3)
  reserved           Decimal             @default(0) @map("reserved") @db.Decimal(18, 3)
  averageCostPerUnit Decimal             @default(0) @map("average_cost_per_unit") @db.Decimal(18, 6)
  status             CommonStatus        @map("status")
  version            Int                 @default(1) @map("version")
  createdAt          DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variantRecipes     VariantRecipe[]
  recipeModifiers    RecipeModifier[]
  stockMovements     StockMovement[]
  lossRecords        LossRecord[]
  orderItemMaterials OrderItemMaterial[]

  @@unique([storeId, name])
  @@index([storeId, status])
  @@map("materials")
}

model StockMovement {
  id                BigInt            @id @default(autoincrement()) @map("id")
  dedupeKey         String            @unique @map("dedupe_key") @db.VarChar(160)
  storeId           BigInt            @map("store_id")
  materialId        BigInt            @map("material_id")
  movementType      StockMovementType @map("movement_type")
  quantityDelta     Decimal           @map("quantity_delta") @db.Decimal(18, 3)
  reservedDelta     Decimal           @map("reserved_delta") @db.Decimal(18, 3)
  onHandAfter       Decimal           @map("on_hand_after") @db.Decimal(18, 3)
  reservedAfter     Decimal           @map("reserved_after") @db.Decimal(18, 3)
  unitCostSnapshot  Decimal?          @map("unit_cost_snapshot") @db.Decimal(18, 6)
  totalCostSnapshot Decimal?          @map("total_cost_snapshot") @db.Decimal(18, 6)
  orderId           BigInt?           @map("order_id")
  orderItemId       BigInt?           @map("order_item_id")
  operatorStaffId   BigInt?           @map("operator_staff_id")
  reason            String?           @map("reason") @db.VarChar(500)
  createdAt         DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  material          Material          @relation(fields: [materialId], references: [id], onDelete: Restrict)
  order             Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem         OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  operatorStaff     Staff?            @relation("StockOperator", fields: [operatorStaffId], references: [id], onDelete: Restrict)
  lossRecord        LossRecord?

  @@index([materialId, createdAt])
  @@index([orderId, movementType])
  @@index([storeId, movementType, createdAt])
  @@map("stock_movements")
}

model LossRecord {
  id               BigInt         @id @default(autoincrement()) @map("id")
  dedupeKey        String         @unique @map("dedupe_key") @db.VarChar(160)
  storeId          BigInt         @map("store_id")
  materialId       BigInt         @map("material_id")
  orderId          BigInt?        @map("order_id")
  orderItemId      BigInt?        @map("order_item_id")
  stockMovementId  BigInt?        @unique @map("stock_movement_id")
  quantity         Decimal        @map("quantity") @db.Decimal(18, 3)
  unitCostSnapshot Decimal        @map("unit_cost_snapshot") @db.Decimal(18, 6)
  lossCostSnapshot Decimal        @map("loss_cost_snapshot") @db.Decimal(18, 6)
  reason           String         @map("reason") @db.VarChar(500)
  operatorStaffId  BigInt?        @map("operator_staff_id")
  occurredAt       DateTime       @map("occurred_at") @db.DateTime(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  material         Material       @relation(fields: [materialId], references: [id], onDelete: Restrict)
  order            Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem        OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  stockMovement    StockMovement? @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  operatorStaff    Staff?         @relation("LossOperator", fields: [operatorStaffId], references: [id], onDelete: Restrict)

  @@index([materialId, occurredAt])
  @@index([storeId, occurredAt])
  @@map("loss_records")
}

model DiningTable {
  id        BigInt          @id @default(autoincrement()) @map("id")
  storeId   BigInt          @map("store_id")
  name      String          @map("name") @db.VarChar(40)
  code      String          @map("code") @db.VarChar(40)
  createdAt DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  sessions  DiningSession[]

  @@unique([storeId, code])
  @@map("dining_tables")
}

model DiningSession {
  id              BigInt              @id @default(autoincrement()) @map("id")
  storeId         BigInt              @map("store_id")
  tableId         BigInt              @map("table_id")
  status          DiningSessionStatus @map("status")
  version         Int                 @default(1) @map("version")
  openedAt        DateTime            @map("opened_at") @db.DateTime(3)
  closedAt        DateTime?           @map("closed_at") @db.DateTime(3)
  closedByStaffId BigInt?             @map("closed_by_staff_id")
  createdAt       DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  store           Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  table           DiningTable         @relation(fields: [tableId], references: [id], onDelete: Restrict)
  closedBy        Staff?              @relation("SessionCloser", fields: [closedByStaffId], references: [id], onDelete: Restrict)
  orders          Order[]
  payments        PaymentRecord[]

  @@index([tableId, status])
  @@index([storeId, status, openedAt])
  @@map("dining_sessions")
}

model Order {
  id             BigInt          @id @default(autoincrement()) @map("id")
  storeId        BigInt          @map("store_id")
  customerUserId BigInt          @map("customer_user_id")
  orderNo        String          @unique @map("order_no") @db.VarChar(40)
  idempotencyKey String          @unique @map("idempotency_key") @db.VarChar(160)
  channel        OrderChannel    @map("channel")
  sessionId      BigInt?         @map("session_id")
  status         OrderStatus     @map("status")
  subtotalFen    BigInt          @map("subtotal_fen")
  totalAmountFen BigInt          @map("total_amount_fen")
  version        Int             @default(1) @map("version")
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  acceptedAt     DateTime?       @map("accepted_at") @db.DateTime(3)
  preparingAt    DateTime?       @map("preparing_at") @db.DateTime(3)
  completedAt    DateTime?       @map("completed_at") @db.DateTime(3)
  cancelledAt    DateTime?       @map("cancelled_at") @db.DateTime(3)
  cancelReason   String?         @map("cancel_reason") @db.VarChar(500)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer       User            @relation(fields: [customerUserId], references: [id], onDelete: Restrict)
  session        DiningSession?  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  stockMovements StockMovement[]
  lossRecords    LossRecord[]
  payments       PaymentRecord[]

  @@index([storeId, status, createdAt])
  @@index([sessionId, status])
  @@index([customerUserId, createdAt])
  @@index([completedAt])
  @@map("orders")
}

model OrderItem {
  id                  BigInt              @id @default(autoincrement()) @map("id")
  orderId             BigInt              @map("order_id")
  productId           BigInt              @map("product_id")
  variantId           BigInt              @map("variant_id")
  productNameSnapshot String              @map("product_name_snapshot") @db.VarChar(120)
  variantNameSnapshot String              @map("variant_name_snapshot") @db.VarChar(80)
  unitPriceFen        BigInt              @map("unit_price_fen")
  quantity            Int                 @map("quantity")
  lineSubtotalFen     BigInt              @map("line_subtotal_fen")
  remark              String?             @map("remark") @db.VarChar(500)
  createdAt           DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product             Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant             ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  options             OrderItemOption[]
  materials           OrderItemMaterial[]
  stockMovements      StockMovement[]
  lossRecords         LossRecord[]

  @@index([orderId])
  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@map("order_items")
}

model OrderItemOption {
  id                    BigInt             @id @default(autoincrement()) @map("id")
  orderItemId           BigInt             @map("order_item_id")
  optionValueId         BigInt             @map("option_value_id")
  groupNameSnapshot     String             @map("group_name_snapshot") @db.VarChar(80)
  valueNameSnapshot     String             @map("value_name_snapshot") @db.VarChar(80)
  priceDeltaFenSnapshot BigInt             @map("price_delta_fen_snapshot")
  orderItem             OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  optionValue           VariantOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, optionValueId])
  @@index([optionValueId])
  @@map("order_item_options")
}

model OrderItemMaterial {
  id                      BigInt                  @id @default(autoincrement()) @map("id")
  orderItemId             BigInt                  @map("order_item_id")
  materialId              BigInt                  @map("material_id")
  materialNameSnapshot    String                  @map("material_name_snapshot") @db.VarChar(120)
  unitSnapshot            String                  @map("unit_snapshot") @db.VarChar(20)
  quantityPerItem         Decimal                 @map("quantity_per_item") @db.Decimal(18, 3)
  totalQuantity           Decimal                 @map("total_quantity") @db.Decimal(18, 3)
  actualUnitCostSnapshot  Decimal?                @map("actual_unit_cost_snapshot") @db.Decimal(18, 6)
  actualTotalCostSnapshot Decimal?                @map("actual_total_cost_snapshot") @db.Decimal(18, 6)
  source                  OrderItemMaterialSource @map("source")
  orderItem               OrderItem               @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  material                Material                @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, materialId, source])
  @@index([materialId])
  @@map("order_item_materials")
}

model PaymentRecord {
  id              BigInt         @id @default(autoincrement()) @map("id")
  paymentNo       String         @unique @map("payment_no") @db.VarChar(64)
  idempotencyKey  String         @unique @map("idempotency_key") @db.VarChar(160)
  storeId         BigInt         @map("store_id")
  sessionId       BigInt?        @map("session_id")
  orderId         BigInt?        @map("order_id")
  paymentMethod   PaymentMethod  @map("payment_method")
  amountFen       BigInt         @map("amount_fen")
  receivedAt      DateTime       @map("received_at") @db.DateTime(3)
  operatorStaffId BigInt?        @map("operator_staff_id")
  status          PaymentStatus  @map("status")
  remark          String?        @map("remark") @db.VarChar(500)
  voidedAt        DateTime?      @map("voided_at") @db.DateTime(3)
  voidedByStaffId BigInt?        @map("voided_by_staff_id")
  voidReason      String?        @map("void_reason") @db.VarChar(500)
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  session         DiningSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  operatorStaff   Staff?         @relation("PaymentOperator", fields: [operatorStaffId], references: [id], onDelete: Restrict)
  voidedByStaff   Staff?         @relation("PaymentVoidOperator", fields: [voidedByStaffId], references: [id], onDelete: Restrict)
  refunds         RefundRecord[]

  @@index([storeId, status, receivedAt])
  @@index([sessionId, status])
  @@index([orderId, status])
  @@map("payment_records")
}

model RefundRecord {
  id              BigInt        @id @default(autoincrement()) @map("id")
  refundNo        String        @unique @map("refund_no") @db.VarChar(64)
  idempotencyKey  String        @unique @map("idempotency_key") @db.VarChar(160)
  paymentRecordId BigInt        @map("payment_record_id")
  amountFen       BigInt        @map("amount_fen")
  reason          String        @map("reason") @db.VarChar(500)
  status          RefundStatus  @map("status")
  refundedAt      DateTime      @map("refunded_at") @db.DateTime(3)
  operatorStaffId BigInt?       @map("operator_staff_id")
  voidedAt        DateTime?     @map("voided_at") @db.DateTime(3)
  voidedByStaffId BigInt?       @map("voided_by_staff_id")
  voidReason      String?       @map("void_reason") @db.VarChar(500)
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  paymentRecord   PaymentRecord @relation(fields: [paymentRecordId], references: [id], onDelete: Restrict)
  operatorStaff   Staff?        @relation("RefundOperator", fields: [operatorStaffId], references: [id], onDelete: Restrict)
  voidedByStaff   Staff?        @relation("RefundVoidOperator", fields: [voidedByStaffId], references: [id], onDelete: Restrict)

  @@index([paymentRecordId, status, refundedAt])
  @@map("refund_records")
}
