{
  "name": "@sanweichawu/backend",
  "version": "0.1.0",
  "private": true,
  "description": "三味茶屋后端工程骨架",
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts --exclude '**/*.database*.spec.ts'",
    "test:database": "vitest run --config vitest.config.ts --no-file-parallelism test/auth.database.spec.ts test/auth.database.concurrency.spec.ts test/bootstrap-owner.database.spec.ts test/resource-ownership.database.spec.ts test/dining-tables.database.spec.ts test/product-menu.database.spec.ts",
    "test:bootstrap-startup": "node scripts/build.mjs && tsx test/support/bootstrap-startup.process.ts",
    "prisma:format": "prisma format --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:check-contract": "node scripts/check-schema.mjs",
    "prisma:check-migrations": "node scripts/check-migration-sql.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@prisma/client": "6.19.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "prisma": "6.19.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
