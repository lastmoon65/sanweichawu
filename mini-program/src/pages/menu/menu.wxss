.menu-shell {
  padding: 56rpx 32rpx 320rpx;
}

.menu-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.page-title {
  margin-top: 12rpx;
  font-family: 'Songti SC', serif;
  font-size: 64rpx;
  letter-spacing: 6rpx;
}

.orders-link {
  padding-bottom: 10rpx;
  color: #56705f;
  font-size: 26rpx;
}

.category-bar {
  margin-top: 36rpx;
  white-space: nowrap;
}

.category-chip {
  display: inline-block;
  margin-right: 16rpx;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.62);
  color: #637066;
  font-size: 26rpx;
}

.category-chip-active {
  background: #244c3a;
  color: #ffffff;
}

.product-list {
  margin-top: 28rpx;
}

.product-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(36, 76, 58, 0.12);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.82);
}

.product-name {
  font-size: 34rpx;
  font-weight: 600;
}

.product-description {
  margin-top: 10rpx;
  color: #6d786f;
  font-size: 24rpx;
  line-height: 1.6;
}

.variant-list {
  margin-top: 22rpx;
}

.variant-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(36, 76, 58, 0.08);
}

.variant-name {
  font-size: 28rpx;
}

.variant-price {
  margin-top: 6rpx;
  color: #8a5b34;
  font-size: 26rpx;
}

.add-button {
  margin: 0;
  border-radius: 999rpx;
  background: #e8efe9;
  color: #244c3a;
  font-size: 24rpx;
}

.cart-panel {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  max-height: 58vh;
  overflow-y: auto;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(36, 76, 58, 0.12);
  background: #fbfaf6;
  box-shadow: 0 -16rpx 40rpx rgba(36, 76, 58, 0.08);
}

.cart-title {
  font-size: 28rpx;
  font-weight: 600;
}

.cart-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(36, 76, 58, 0.08);
}

.cart-line-name {
  font-size: 26rpx;
}

.cart-line-price {
  margin-top: 6rpx;
  color: #8a5b34;
  font-size: 24rpx;
}

.quantity-controls {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.quantity-button {
  width: 56rpx;
  height: 56rpx;
  min-height: 56rpx;
  padding: 0;
  border-radius: 50%;
  background: #e8efe9;
  color: #244c3a;
  font-size: 28rpx;
  line-height: 56rpx;
}

.quantity-value {
  min-width: 36rpx;
  text-align: center;
}

.submit-button {
  margin-top: 24rpx;
}
