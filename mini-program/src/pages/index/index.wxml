<view class="page-shell home-shell">
  <view class="eyebrow">SANWEI TEA HOUSE</view>
  <view class="title">三味茶屋</view>
  <view class="subtitle">扫码入座，开始点单</view>

  <view wx:if="{{loggingIn}}" class="hint">正在完成微信登录…</view>
  <view wx:if="{{error}}" class="error-banner">{{error}}</view>

  <button class="primary-button" bindtap="onScan" loading="{{loading}}" disabled="{{loading}}">
    扫码点单
  </button>

  <view class="divider"><text>或手动输入桌码</text></view>
  <input
    class="code-input"
    value="{{tableCodeInput}}"
    maxlength="40"
    placeholder="例如 A1"
    bindinput="onCodeInput"
  />
  <button
    class="secondary-button"
    bindtap="onManualResolve"
    loading="{{loading}}"
    disabled="{{loading}}"
  >
    进入菜单
  </button>

  <view class="support-note">如无法进入，请呼叫店员确认桌台是否已开台。</view>
</view>
