.home-shell {
  padding-top: 120rpx;
}

.subtitle {
  margin-top: 18rpx;
  color: #637066;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.hint {
  margin-top: 56rpx;
  color: #637066;
  font-size: 26rpx;
}

.primary-button,
.secondary-button {
  margin-top: 40rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.primary-button {
  background: #244c3a;
  color: #ffffff;
}

.secondary-button {
  margin-top: 24rpx;
  border: 1rpx solid rgba(36, 76, 58, 0.28);
  background: rgba(255, 255, 255, 0.74);
  color: #244c3a;
}

.divider {
  margin: 64rpx 0 28rpx;
  color: #7a847c;
  font-size: 24rpx;
  text-align: center;
}

.code-input {
  height: 96rpx;
  padding: 0 32rpx;
  border: 1rpx solid rgba(36, 76, 58, 0.18);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  font-size: 32rpx;
  text-align: center;
}

.support-note {
  margin-top: 120rpx;
  color: #7a847c;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
}
