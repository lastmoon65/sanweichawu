.page-shell {
  min-height: 100vh;
  padding: 96rpx 48rpx;
  box-sizing: border-box;
}

.eyebrow {
  color: #56705f;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
}

.title {
  margin-top: 24rpx;
  font-family: 'Songti SC', serif;
  font-size: 96rpx;
  letter-spacing: 12rpx;
}

.status-card {
  margin-top: 96rpx;
  padding: 40rpx;
  border: 1rpx solid rgba(36, 76, 58, 0.16);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 30rpx;
  font-weight: 600;
}

.description {
  margin-top: 24rpx;
  color: #637066;
  font-size: 26rpx;
  line-height: 1.8;
}
