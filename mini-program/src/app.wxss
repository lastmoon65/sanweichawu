page {
  background: #f2eee4;
  color: #24382d;
}

.page-shell {
  min-height: 100vh;
  padding: 96rpx 48rpx;
  box-sizing: border-box;
}

.eyebrow {
  color: #56705f;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
}

.title {
  margin-top: 24rpx;
  font-family: 'Songti SC', serif;
  font-size: 96rpx;
  letter-spacing: 12rpx;
}

.error-banner {
  margin-top: 28rpx;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  background: #f8e9e4;
  color: #8a3f2b;
  font-size: 25rpx;
  line-height: 1.6;
}

.hint {
  margin-top: 28rpx;
  color: #637066;
  font-size: 26rpx;
}

.empty-state {
  margin-top: 80rpx;
  color: #7a847c;
  font-size: 27rpx;
  text-align: center;
}

.primary-button {
  background: #244c3a;
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid rgba(36, 76, 58, 0.22);
  background: rgba(255, 255, 255, 0.76);
  color: #244c3a;
}

.primary-button,
.secondary-button {
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}
